# Copy this file to .env and fill in your own values.
# The dev server injects these as an Authorization header on /jira/* requests;
# they never reach browser code. Restart `npm run dev` after changing them
# (Vite usually auto-restarts on .env changes).

# Your Jira Cloud site, no trailing slash
JIRA_BASE_URL=https://yoursite.atlassian.net

# The Atlassian account email the token belongs to
JIRA_EMAIL=you@example.com

# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token
